{
  "name": "bim-management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=bim-management-production --local --ip 0.0.0.0 --port 3000 --binding JWT_SECRET=local-preview-jwt-secret-bim-pm-2026 --binding ALLOW_PREVIEW=1",
    "preview:local": "npm run build && npm run db:migrate:local && wrangler pages dev dist --d1=bim-management-production --local --port 8788 --binding JWT_SECRET=local-preview-jwt-secret-bim-pm-2026 --binding ALLOW_PREVIEW=1",
    "preview:watch": "node scripts/preview-watch.mjs",
    "build": "vite build && node scripts/copy-public.mjs",
    "build:worker": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name bim-management",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply bim-management-production --local",
    "db:seed": "wrangler d1 execute bim-management-production --local --file=./migrations/0002_seed_data.sql",
    "db:seed:test": "wrangler d1 execute bim-management-production --local --file=./scripts/seed-test-users.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.2"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0",
    "sharp": "^0.34.5"
  }
}